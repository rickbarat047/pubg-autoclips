/* PUBG AutoClips — professional dark theme.
   Generated from app/ui/tokens.py palette; keep values in sync. */

QWidget {
    background: #171A1E;
    color: #F3F4F6;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 14px;
}
QMainWindow, QDialog { background: #171A1E; }

/* Shell / sidebar */
#sidebar { background: #14171A; border-right: 1px solid #343B43; }
#brand { font-size: 17px; font-weight: 700; color: #F3F4F6; }
#brandSub { font-size: 11px; color: #A3E635; letter-spacing: 2px; }
QPushButton#navBtn {
    background: transparent; color: #9CA3AF; border: none;
    text-align: left; padding: 12px 16px; border-radius: 8px;
    font-size: 14px; font-weight: 600;
}
QPushButton#navBtn:hover { background: #272D34; color: #F3F4F6; }
QPushButton#navBtn:checked {
    background: #20252B; color: #A3E635;
    border-left: 3px solid #A3E635;
}

/* Content / typography */
#content { background: #171A1E; }
QLabel#pageTitle { font-size: 26px; font-weight: 700; color: #F3F4F6; }
QLabel#pageSubtitle { font-size: 14px; color: #9CA3AF; }
QLabel#sectionTitle { font-size: 17px; font-weight: 700; color: #F3F4F6; }
QLabel#muted { color: #737D88; }
QLabel#accent { color: #A3E635; font-weight: 600; }
QLabel#stepIdle { color: #737D88; font-size: 12px; font-weight: 600; }
QLabel#stepActive {
    color: #171A1E; font-size: 12px; font-weight: 700;
    background: #A3E635; border-radius: 12px;
    padding: 4px 10px;
}

/* Cards */
QFrame#card {
    background: #20252B;
    border: 1px solid #343B43;
    border-radius: 12px;
}
QFrame#cardHover:hover { border: 1px solid #A3E635; background: #272D34; }
QLabel#statValue { font-size: 28px; font-weight: 700; color: #A3E635; }
QLabel#statLabel { font-size: 12px; color: #9CA3AF; }

/* Buttons */
QPushButton {
    background: #272D34; color: #F3F4F6; border: 1px solid #343B43;
    border-radius: 8px; padding: 9px 16px; font-weight: 600;
}
QPushButton:hover { background: #343B43; }
QPushButton:pressed { background: #20252B; }
QPushButton:disabled { background: #20252B; color: #737D88; border-color: #343B43; }
QPushButton#primary {
    background: #A3E635; color: #171A1E; border: 1px solid #BEF264;
}
QPushButton#primary:hover { background: #BEF264; }
QPushButton#primary:disabled { background: #343B43; color: #737D88; }
QPushButton#danger { background: #272D34; color: #EF4444; border: 1px solid #EF4444; }
QPushButton#danger:hover { background: #343B43; }
QPushButton#ghost { background: transparent; border: 1px solid #343B43; }
QPushButton#ghost:hover { background: #272D34; }

/* Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit {
    background: #14171A; border: 1px solid #343B43; border-radius: 7px;
    padding: 8px 10px; color: #F3F4F6; selection-background-color: #A3E635;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #A3E635; }
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background: #20252B; border: 1px solid #343B43; selection-background-color: #272D34;
}
QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 17px; height: 17px; border-radius: 4px;
    border: 1px solid #343B43; background: #14171A;
}
QCheckBox::indicator:checked { background: #A3E635; border-color: #A3E635; }

/* Lists / tables */
QListWidget, QTableWidget, QTreeWidget {
    background: #171A1E; border: 1px solid #343B43; border-radius: 10px;
    gridline-color: #343B43;
}
QListWidget::item { padding: 8px; border-radius: 6px; }
QListWidget::item:selected { background: #20252B; color: #A3E635; }
QHeaderView::section {
    background: #20252B; color: #9CA3AF; border: none;
    padding: 8px; font-weight: 600;
}

/* Progress */
QProgressBar {
    background: #272D34; border: none; border-radius: 6px;
    height: 8px; text-align: center; color: transparent;
}
QProgressBar::chunk { background: #A3E635; border-radius: 6px; }

/* Scrollbars */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #343B43; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #737D88; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

/* Status / tabs */
QStatusBar { background: #14171A; color: #737D88; }
QTabWidget::pane { border: 1px solid #343B43; border-radius: 8px; }
QTabBar::tab {
    background: #20252B; color: #9CA3AF; padding: 9px 16px;
    border-top-left-radius: 7px; border-top-right-radius: 7px;
}
QTabBar::tab:selected { color: #A3E635; background: #272D34; }
QSplitter::handle { background: #343B43; }

/* Drop zone */
#dropZone {
    border: 2px dashed #343B43; border-radius: 12px; background: #20252B;
}
#dropZoneActive { border: 2px dashed #A3E635; background: #20252B; }

/* Messages */
QMessageBox { background: #20252B; }
QToolTip {
    background: #272D34; color: #F3F4F6; border: 1px solid #343B43;
    padding: 5px; border-radius: 5px;
}
